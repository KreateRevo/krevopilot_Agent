PLATFORM_URL=https://krevopilot.yourcompany.com
CLUSTER_ID=prod-cluster-1
AGENT_KEY=replace-with-the-platform-agent-ingest-key
HASH_SALT=replace-with-a-random-value-at-least-16-characters
INTERVAL_SECONDS=60
MAX_PODS=150
MAX_EVENTS=60
VERIFY_TLS=true
ALLOW_INSECURE_HTTP=false
LOG_LEVEL=INFO
PRESERVE_NAMESPACES=true
EVENT_MESSAGE_MODE=scrubbed
LOGS_ENABLED=false
LOGS_MAX_LINES=500
LOGS_MAX_LOOKBACK_MINUTES=60
LOGS_INCLUDE_PREVIOUS=true
LOGS_MASK_EMAILS=true
LOGS_MASK_PUBLIC_IPS=true
LOGS_MASK_INTERNAL_IPS=false
LOG_STORAGE_MODE=none
EXTERNAL_LOG_SOURCE=none
